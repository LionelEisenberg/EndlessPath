[resource]
script = ExtResource("1_tribdata")
target_stage = 1
title = "The Tribulation"
intro_text = "Your core is full. Breathe with the aura as it gathers, and let it pour into you."
rules_text = "{cracks} cracks end the trial and cost {levels} levels of Core Density."
last_breath_name = "The last breath"
last_breath_tip = "Press as it crosses the ring, then hold while it pours into your core"
pass_title = "Breakthrough"
pass_text = "Your core condenses into Copper."
fail_title = "Your core cracks"
fail_text = "Core Density falls from {before} to {after}."
tempo = 1.0
lead_in = 1.2
phases = Array[ExtResource("2_tribphase")]([SubResource("Phase_steady"), SubResource("Phase_heartbeat"), SubResource("Phase_echo"), SubResource("Phase_quickening")])
last_breath_gap = 0.5
last_breath_in = 1.8
last_breath_out = 4.5
last_breath_max_ratio = 2.54
end_pause = 1.2
sphere_min_ratio = 0.42
sphere_max_ratio = 1.88
perfect_window = 0.07
good_window = 0.14
early_reach_min = 0.3
release_tolerance = 0.05
cracks_to_fail = 4
failure_level_loss = 5
